marketplace_lifecycle:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('DBT_SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('DBT_SNOWFLAKE_USER') }}"
      password: "{{ env_var('DBT_SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('DBT_SNOWFLAKE_ROLE', 'TRANSFORMER') }}"
      database: "{{ env_var('DBT_SNOWFLAKE_DATABASE', 'MARKETPLACE_ANALYTICS') }}"
      warehouse: "{{ env_var('DBT_SNOWFLAKE_WAREHOUSE', 'MARKETPLACE_TRANSFORM_WH') }}"
      schema: "{{ env_var('DBT_SNOWFLAKE_SCHEMA', 'LIFECYCLE_DEV') }}"
      threads: 4
      client_session_keep_alive: false
